# HealthGPT AI - Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/healthgpt

# Secret key for JWT signing
SECRET_KEY=replace-with-a-secure-secret

# JWT algorithm
ALGORITHM=HS256

# JWT access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini API key (used in a future milestone)
GEMINI_API_KEY=replace-with-api-key

# Comma-separated list of allowed CORS origins for local development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API base URL (used by the Vite dev server)
# If not set, the frontend uses /api/v1 which is proxied to the backend.
VITE_API_URL=http://localhost:8001